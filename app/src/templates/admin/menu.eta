<% layout("/layouts/admin-base", { title: "Menu", user: it.user, adminBase: it.adminBase, csrfToken: it.csrfToken }) %>
<%
const STYLE_LABELS = {
  "underline-slide": "Underline slide",
  "pill-fill": "Pill fill",
  "spotlight-glow": "Spotlight glow",
  "magnetic-snap": "Magnetic snap",
  "bracket-frame": "Bracket frame",
  "bg-slide": "Background slide",
};
const STYLE_DESCRIPTIONS = {
  "underline-slide": "A 2px line slides under the label on hover. Restrained, editorial.",
  "pill-fill": "Rounded chip background fills with accent color on hover. Modern, friendly.",
  "spotlight-glow": "Soft halo blooms outward from the label on hover. Distinctive, slightly playful.",
  "magnetic-snap": "Item lifts upward 3px with a soft shadow on hover. Springy.",
  "bracket-frame": "Brackets [ ] appear around the label on hover. Terminal-flavoured.",
  "bg-slide": "A solid accent block slides up from below to fill the item. Bold.",
};

const FEATURED_LABELS = {
  "star-prefix": "Star prefix",
  "pill-solid": "Solid pill",
  "pill-outline": "Outline pill",
  "underline-thick": "Thick underline",
  "badge-corner": "Corner badge",
};
const FEATURED_DESCRIPTIONS = {
  "star-prefix": "Bold accent label with a ★ prefix. Subtle.",
  "pill-solid": "Solid accent-filled rounded chip with inverted text. Loudest.",
  "pill-outline": "Accent ring around the label, fills on hover.",
  "underline-thick": "Always-visible 3px accent underline. Classic.",
  "badge-corner": "Small ★ corner badge, top-right of the label.",
};

const PREVIEW_CSS = `
:root { color-scheme: light dark;
  --fg: #18181b; --fg-muted: #5a5a5a; --accent: #7c3aed; --accent-hover: #6d28d9;
  --accent-subtle: #ede9fe; --fg-on-accent: #ffffff; --border: #e5e1d8; --bg-elevated: #ffffff; }
@media (prefers-color-scheme: dark) {
  :root { --fg: #f5f4f0; --fg-muted: #a8a5a0; --accent: #a78bfa; --accent-hover: #c4b5fd;
    --accent-subtle: #2a1f4a; --fg-on-accent: #0f0e12; --border: #26242c; --bg-elevated: #17161c; }
}
html, body { margin: 0; padding: 14px 16px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; font-size: 14px; }
.nav { display: flex; gap: 16px; align-items: center; }
.nav a { color: var(--fg-muted); text-decoration: none; font-weight: 500; font-size: 13px; transition: color 160ms ease; }

.nav[data-menu-style="underline-slide"] a { position: relative; padding: 4px 0; }
.nav[data-menu-style="underline-slide"] a::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: currentColor; transform: scaleX(0); transform-origin: right; transition: transform 200ms ease; }
.nav[data-menu-style="underline-slide"] a:hover { color: var(--fg); }
.nav[data-menu-style="underline-slide"] a:hover::after, .nav[data-menu-style="underline-slide"] a[aria-current="page"]::after { transform: scaleX(1); transform-origin: left; }
.nav[data-menu-style="underline-slide"] a[aria-current="page"] { color: var(--accent); }

.nav[data-menu-style="pill-fill"] a { padding: 6px 12px; border-radius: 9999px; transition: background 160ms ease, color 160ms ease; }
.nav[data-menu-style="pill-fill"] a:hover { background: var(--accent-subtle); color: var(--accent); }
.nav[data-menu-style="pill-fill"] a[aria-current="page"] { background: var(--accent); color: var(--fg-on-accent); }

.nav[data-menu-style="spotlight-glow"] a { padding: 4px 8px; border-radius: 4px; transition: color 220ms ease, box-shadow 220ms ease, text-shadow 220ms ease; }
.nav[data-menu-style="spotlight-glow"] a:hover { color: var(--fg); box-shadow: 0 0 0 6px var(--accent-subtle); text-shadow: 0 0 8px var(--accent-subtle); }
.nav[data-menu-style="spotlight-glow"] a[aria-current="page"] { color: var(--accent); }

.nav[data-menu-style="magnetic-snap"] a { padding: 4px 8px; border-radius: 4px; transform: translateY(0); transition: transform 180ms cubic-bezier(.34,1.56,.64,1), color 160ms ease, box-shadow 180ms ease; }
.nav[data-menu-style="magnetic-snap"] a:hover { color: var(--fg); transform: translateY(-3px); box-shadow: 0 4px 12px -4px rgba(0,0,0,0.35); }
.nav[data-menu-style="magnetic-snap"] a[aria-current="page"] { color: var(--accent); }

.nav[data-menu-style="bracket-frame"] a { padding: 4px 12px; position: relative; transition: color 160ms ease; font-family: ui-monospace, monospace; }
.nav[data-menu-style="bracket-frame"] a::before, .nav[data-menu-style="bracket-frame"] a::after { content: ""; opacity: 0; position: absolute; top: 50%; transform: translateY(-50%); color: var(--accent); transition: opacity 160ms ease, content 0s; font-weight: 700; }
.nav[data-menu-style="bracket-frame"] a::before { content: "["; left: 0; }
.nav[data-menu-style="bracket-frame"] a::after { content: "]"; right: 0; }
.nav[data-menu-style="bracket-frame"] a:hover { color: var(--fg); }
.nav[data-menu-style="bracket-frame"] a:hover::before, .nav[data-menu-style="bracket-frame"] a:hover::after, .nav[data-menu-style="bracket-frame"] a[aria-current="page"]::before, .nav[data-menu-style="bracket-frame"] a[aria-current="page"]::after { opacity: 1; }
.nav[data-menu-style="bracket-frame"] a[aria-current="page"] { color: var(--accent); }

.nav[data-menu-style="bg-slide"] a { padding: 4px 10px; position: relative; overflow: hidden; isolation: isolate; transition: color 200ms ease; }
.nav[data-menu-style="bg-slide"] a::before { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 100%; background: var(--accent); transform: translateY(100%); transition: transform 220ms cubic-bezier(.4,0,.2,1); z-index: -1; }
.nav[data-menu-style="bg-slide"] a:hover { color: var(--fg-on-accent); }
.nav[data-menu-style="bg-slide"] a:hover::before { transform: translateY(0); }
.nav[data-menu-style="bg-slide"] a[aria-current="page"] { color: var(--fg-on-accent); }
.nav[data-menu-style="bg-slide"] a[aria-current="page"]::before { transform: translateY(0); }

/* Featured presets */
.nav[data-featured-style="star-prefix"] .is-featured { font-weight: 700; color: var(--accent); }
.nav[data-featured-style="star-prefix"] .is-featured::before { content: "★ "; font-size: 0.85em; color: var(--accent); }
.nav[data-featured-style="pill-solid"] .is-featured { padding: 4px 14px; border-radius: 9999px; background: var(--accent); color: var(--fg-on-accent); font-weight: 600; }
.nav[data-featured-style="pill-outline"] .is-featured { padding: 3px 13px; border-radius: 9999px; border: 1.5px solid var(--accent); color: var(--accent); font-weight: 600; }
.nav[data-featured-style="underline-thick"] .is-featured { color: var(--accent); font-weight: 700; padding-bottom: 2px; border-bottom: 3px solid var(--accent); }
.nav[data-featured-style="badge-corner"] .is-featured { position: relative; color: var(--accent); font-weight: 700; padding-right: 14px; }
.nav[data-featured-style="badge-corner"] .is-featured::after { content: "★"; position: absolute; top: -6px; right: 0; font-size: 0.7em; color: var(--accent); line-height: 1; }
`;
function previewSrcdoc(style) {
  return "<!doctype html><html><head><style>" + PREVIEW_CSS + "</style></head><body>" +
    "<nav class='nav' data-menu-style='" + style + "'>" +
    "<a href='#'>Work</a><a href='#' aria-current='page'>Writing</a><a href='#'>About</a>" +
    "</nav></body></html>";
}
function featuredPreviewSrcdoc(featuredStyle) {
  return "<!doctype html><html><head><style>" + PREVIEW_CSS + "</style></head><body>" +
    "<nav class='nav' data-featured-style='" + featuredStyle + "'>" +
    "<a href='#'>Work</a><a href='#' class='is-featured'>Hire me</a><a href='#'>About</a>" +
    "</nav></body></html>";
}
%>

<section class="page">
  <header class="page-head">
    <h1>Menu</h1>
    <p>Manage navigation items, parents, the featured highlight, and the hover style. Click <strong>Publish</strong> in the header to apply.</p>
  </header>

  <% if (it.flash === "style-saved") { %><p class="flash flash-ok">Hover style saved. Click Publish in the header to apply.</p><% } %>
  <% if (it.flash === "featured-style-saved") { %><p class="flash flash-ok">Featured style saved. Click Publish in the header to apply.</p><% } %>
  <% if (it.flash === "created") { %><p class="flash flash-ok">Item added.</p><% } %>
  <% if (it.flash === "saved") { %><p class="flash flash-ok">Item updated.</p><% } %>
  <% if (it.flash === "deleted") { %><p class="flash flash-ok">Item deleted.</p><% } %>
  <% if (it.flash === "reordered") { %><p class="flash flash-ok">Order updated.</p><% } %>
  <% if (it.error) { %><p class="flash flash-warn"><%= it.error %></p><% } %>

  <div class="tabs">
    <input type="radio" name="menu-tab" id="menu-tab-items"    class="tabs-input" <%= it.activeTab === "items"    ? "checked" : "" %> />
    <input type="radio" name="menu-tab" id="menu-tab-hover"    class="tabs-input" <%= it.activeTab === "hover"    ? "checked" : "" %> />
    <input type="radio" name="menu-tab" id="menu-tab-featured" class="tabs-input" <%= it.activeTab === "featured" ? "checked" : "" %> />

    <nav class="tabs-strip" aria-label="Menu sections">
      <label for="menu-tab-items"    class="tabs-tab">Items <span class="tabs-count"><%= it.items.length %></span></label>
      <label for="menu-tab-hover"    class="tabs-tab">Hover style <span class="tabs-count"><%= it.styles.length %></span></label>
      <label for="menu-tab-featured" class="tabs-tab">Featured style <span class="tabs-count"><%= it.featuredStyles.length %></span></label>
    </nav>

    <section class="tabs-panel" data-tab="items">
      <p class="tabs-hint">Children indent under their parent; submenus show on hover on the public site.</p>
      <% if (it.items.length === 0) { %>
      <p class="empty-cell">No items yet. Add one below.</p>
      <% } %>
      <% it.items.forEach(function(m, idx){ %>
      <div class="menu-row <%= m.depth === 1 ? 'menu-row-child' : '' %> <%= m.is_featured ? 'menu-row-featured' : '' %>">
        <div class="menu-row-order">
          <form method="post" action="<%= it.adminBase %>/menu/<%= m.id %>/up" class="inline">
            <input type="hidden" name="_csrf" value="<%= it.csrfToken %>" />
            <button type="submit" class="btn btn-ghost btn-sm" title="Move up">↑</button>
          </form>
          <form method="post" action="<%= it.adminBase %>/menu/<%= m.id %>/down" class="inline">
            <input type="hidden" name="_csrf" value="<%= it.csrfToken %>" />
            <button type="submit" class="btn btn-ghost btn-sm" title="Move down">↓</button>
          </form>
        </div>
        <form method="post" action="<%= it.adminBase %>/menu/<%= m.id %>" class="menu-row-form">
          <input type="hidden" name="_csrf" value="<%= it.csrfToken %>" />
          <input type="text" name="label" required maxlength="50" value="<%= m.label %>" placeholder="Label" title="Visible link text" />
          <input type="text" name="href" required maxlength="250" value="<%= m.href %>" placeholder="work/ or https://…" title="Destination — relative path (work/, about.html, …) or full https:// URL" />
          <select name="parent_id" title="Pick a parent to make this a submenu child. One level of nesting.">
            <option value="">— top level —</option>
            <% it.parents.forEach(function(p){ if (p.id !== m.id) { %>
            <option value="<%= p.id %>" <%= m.parent_id === p.id ? "selected" : "" %>>↳ <%= p.label %></option>
            <% } }); %>
          </select>
          <label class="cb" title="Opens the link in a new browser tab. Recommended for external sites."><input type="checkbox" name="open_new_tab" value="1" <%= m.open_new_tab ? "checked" : "" %> /> new tab</label>
          <label class="cb" title="Hide from the public site without deleting it"><input type="checkbox" name="is_visible" value="1" <%= m.is_visible ? "checked" : "" %> /> visible</label>
          <label class="cb cb-featured" title="Apply the Featured style to this item (set the style in the Featured style tab)"><input type="checkbox" name="is_featured" value="1" <%= m.is_featured ? "checked" : "" %> /> ★ featured</label>
          <button type="submit" class="btn btn-ghost btn-sm">Save</button>
        </form>
        <form method="post" action="<%= it.adminBase %>/menu/<%= m.id %>/delete" class="inline" onsubmit="return confirm('Delete this menu item? Any children will be deleted too.')">
          <input type="hidden" name="_csrf" value="<%= it.csrfToken %>" />
          <button type="submit" class="btn btn-ghost btn-danger btn-sm">Delete</button>
        </form>
      </div>
      <% }); %>

      <form method="post" action="<%= it.adminBase %>/menu/new" class="menu-row menu-row-new">
        <input type="hidden" name="_csrf" value="<%= it.csrfToken %>" />
        <div class="menu-row-order">+ new</div>
        <div class="menu-row-form">
          <input type="text" name="label" required maxlength="50" placeholder="Label (e.g. Résumé)" />
          <input type="text" name="href" required maxlength="250" placeholder="resume.html or https://…" />
          <select name="parent_id">
            <option value="">— top level —</option>
            <% it.parents.forEach(function(p){ %>
            <option value="<%= p.id %>">↳ <%= p.label %></option>
            <% }); %>
          </select>
          <label class="cb"><input type="checkbox" name="open_new_tab" value="1" /> new tab</label>
          <label class="cb"><input type="checkbox" name="is_visible" value="1" checked /> visible</label>
          <label class="cb cb-featured"><input type="checkbox" name="is_featured" value="1" /> ★ featured</label>
          <button type="submit" class="btn btn-primary btn-sm">Add</button>
        </div>
      </form>
    </section>

    <section class="tabs-panel" data-tab="hover">
      <p class="tabs-hint">Applies to every menu item. Click <strong>Publish</strong> after saving to regenerate the public site.</p>
      <form method="post" action="<%= it.adminBase %>/menu/style" class="menu-style-form">
        <input type="hidden" name="_csrf" value="<%= it.csrfToken %>" />
        <div class="menu-style-grid">
          <% it.styles.forEach(function(s){ %>
          <label class="menu-style-card">
            <input type="radio" name="style" value="<%= s %>" <%= s === it.activeStyle ? "checked" : "" %> />
            <div class="menu-style-meta">
              <strong><%= STYLE_LABELS[s] %></strong>
              <span><%= STYLE_DESCRIPTIONS[s] %></span>
            </div>
            <iframe class="menu-style-preview" loading="lazy" srcdoc="<%= previewSrcdoc(s) %>" title="<%= STYLE_LABELS[s] %> preview"></iframe>
          </label>
          <% }); %>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Save hover style</button>
        </div>
      </form>
    </section>

    <section class="tabs-panel" data-tab="featured">
      <p class="tabs-hint">Applies to every item with the ★ flag turned on (set per-item under <strong>Items</strong>).</p>
      <form method="post" action="<%= it.adminBase %>/menu/featured-style" class="menu-style-form">
        <input type="hidden" name="_csrf" value="<%= it.csrfToken %>" />
        <div class="menu-style-grid">
          <% it.featuredStyles.forEach(function(s){ %>
          <label class="menu-style-card">
            <input type="radio" name="style" value="<%= s %>" <%= s === it.activeFeaturedStyle ? "checked" : "" %> />
            <div class="menu-style-meta">
              <strong><%= FEATURED_LABELS[s] %></strong>
              <span><%= FEATURED_DESCRIPTIONS[s] %></span>
            </div>
            <iframe class="menu-style-preview" loading="lazy" srcdoc="<%= featuredPreviewSrcdoc(s) %>" title="<%= FEATURED_LABELS[s] %> preview"></iframe>
          </label>
          <% }); %>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Save featured style</button>
        </div>
      </form>
    </section>
  </div>
</section>

<style>
/* Tabs — CSS-only via hidden radios; default tab pre-checked server-side. */
.tabs > .tabs-input { position: absolute; opacity: 0; pointer-events: none; }
.tabs-strip { display: flex; gap: 4px; border-bottom: 1px solid var(--admin-border); margin: 8px 0 20px; }
.tabs-tab { padding: 10px 18px; font-size: 14px; font-weight: 500; color: var(--admin-fg-muted); cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px; transition: color 160ms ease, border-color 160ms ease; }
.tabs-tab:hover { color: var(--admin-fg); }
.tabs-count { font-size: 11px; color: var(--admin-fg-muted); background: var(--admin-bg-elevated); border: 1px solid var(--admin-border); padding: 0 6px; border-radius: 10px; margin-left: 4px; vertical-align: middle; }
#menu-tab-items:checked    ~ .tabs-strip [for="menu-tab-items"],
#menu-tab-hover:checked    ~ .tabs-strip [for="menu-tab-hover"],
#menu-tab-featured:checked ~ .tabs-strip [for="menu-tab-featured"] {
  color: var(--admin-accent);
  border-bottom-color: var(--admin-accent);
}
.tabs-panel { display: none; }
#menu-tab-items:checked    ~ .tabs-panel[data-tab="items"],
#menu-tab-hover:checked    ~ .tabs-panel[data-tab="hover"],
#menu-tab-featured:checked ~ .tabs-panel[data-tab="featured"] {
  display: block;
}
.tabs-hint { font-size: 13px; color: var(--admin-fg-muted); margin: 0 0 16px; }

.menu-style-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; }
.menu-style-card { display: flex; flex-direction: column; gap: 8px; padding: 14px; background: var(--admin-bg); border: 1px solid var(--admin-border); border-radius: var(--admin-radius); cursor: pointer; }
.menu-style-card:has(input:checked) { border-color: var(--admin-accent); box-shadow: 0 0 0 1px var(--admin-accent) inset; }
.menu-style-card input[type="radio"] { display: none; }
.menu-style-meta { display: flex; flex-direction: column; gap: 4px; }
.menu-style-meta strong { font-size: 14px; color: var(--admin-fg); }
.menu-style-meta span { font-size: 12px; color: var(--admin-fg-muted); line-height: 1.4; }
.menu-style-preview { width: 100%; height: 70px; border: 1px solid var(--admin-border); border-radius: var(--admin-radius-sm); background: #fff; }

.menu-row { display: grid; grid-template-columns: 64px 1fr auto; gap: 10px; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--admin-border); }
.menu-row:last-of-type { border-bottom: 0; }
.menu-row-child { padding-left: 28px; background: rgba(125,125,125,0.04); border-left: 2px solid var(--admin-accent); }
.menu-row-child::before { content: "↳"; color: var(--admin-fg-muted); position: absolute; margin-left: -22px; font-size: 14px; }
.menu-row-featured { background: linear-gradient(90deg, var(--admin-accent-subtle, rgba(168,139,250,0.08)) 0%, transparent 30%); }
.menu-row-order { display: flex; gap: 4px; align-items: center; color: var(--admin-fg-muted); font-size: 12px; }
.menu-row-form { display: grid; grid-template-columns: 1fr 1.6fr 1fr auto auto auto auto; gap: 8px; align-items: center; }
@media (max-width: 1100px) { .menu-row-form { grid-template-columns: 1fr; } }
.menu-row-form input[type="text"], .menu-row-form select { padding: 6px 8px; font-size: 13px; border: 1px solid var(--admin-border); border-radius: var(--admin-radius-sm); background: var(--admin-bg); color: var(--admin-fg); font-family: inherit; }
.menu-row-form .cb { font-size: 12px; color: var(--admin-fg-muted); display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }
.menu-row-form .cb input { margin: 0; }
.cb-featured { color: var(--admin-accent); font-weight: 500; }
.menu-row-new { background: var(--admin-bg-elevated); padding: 12px; margin-top: 12px; border-radius: var(--admin-radius); border: 1px dashed var(--admin-border); }
.btn:disabled { opacity: 0.3; cursor: not-allowed; }
</style>
