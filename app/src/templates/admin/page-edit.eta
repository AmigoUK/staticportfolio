<%
const mode = it.mode || (it.page.slug ? "edit" : "new");
const isNew = mode === "new";
%><% layout("/layouts/admin-base", { title: isNew ? "New page" : "Edit page — " + it.page.title, user: it.user, adminBase: it.adminBase, csrfToken: it.csrfToken }) %>
<section class="page">
  <header class="page-head">
    <p class="back-crumb"><a href="<%= it.adminBase %>/pages/">← Pages</a></p>
    <h1><%= isNew ? "New page" : "Edit page" %><% if (!isNew) { %>: <code><%= it.page.slug %></code><% } %></h1>
  </header>

  <form method="post" action="<%= isNew ? it.adminBase + "/pages/new" : it.adminBase + "/pages/" + it.page.slug %>">
    <input type="hidden" name="_csrf" value="<%= it.csrfToken %>" />

    <% if (isNew) { %>
    <label class="form-row">
      <span>Slug — lowercase letters / digits / dashes; becomes <code>/{slug}.html</code></span>
      <input type="text" name="slug" required pattern="[a-z0-9](?:[a-z0-9\-]{0,80}[a-z0-9])?" maxlength="82" placeholder="e.g. resume, projects, uses" value="<%= it.page.slug || '' %>" />
    </label>
    <% } %>

    <label class="form-row">
      <span>Title</span>
      <input type="text" name="title" required maxlength="200" value="<%= it.page.title %>" />
    </label>

    <label class="form-row">
      <span>Meta description (shown in search results + og:description)</span>
      <input type="text" name="meta_description" maxlength="500" value="<%= it.page.meta_description || '' %>" />
    </label>

    <label class="form-row">
      <span>Body — rich text. Output is sanitized server-side.</span>
      <textarea name="body_html" data-rte rows="20"><%= it.page.body_html || '' %></textarea>
    </label>

    <fieldset class="form-section">
      <legend>Publication</legend>
      <label class="form-row">
        <span>Status</span>
        <select name="status" data-status-select>
          <option value="draft" <%= it.page.status === "draft" ? "selected" : "" %>>Draft — hidden from the public site</option>
          <option value="published" <%= it.page.status === "published" ? "selected" : "" %>>Published — live on the next publish</option>
          <option value="scheduled" <%= it.page.status === "scheduled" ? "selected" : "" %>>Scheduled — appears automatically at a chosen time</option>
        </select>
      </label>
      <label class="form-row" data-status-when>
        <span>Publish at (your local time; only used when status is Scheduled)</span>
        <input type="datetime-local" name="published_at" value="<%= it.page.published_at_local || '' %>" />
      </label>
    </fieldset>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary"><%= isNew ? "Create" : "Save" %></button>
      <a class="btn btn-ghost" href="<%= it.adminBase %>/pages/">Cancel</a>
    </div>
  </form>
</section>

<script src="<%= it.adminBase %>/static/mini-rte.js"></script>
<script>
  (function () {
    const sel = document.querySelector("[data-status-select]");
    const when = document.querySelector("[data-status-when]");
    if (!sel || !when) return;
    const whenInput = when.querySelector("input");
    function sync() {
      const scheduled = sel.value === "scheduled";
      when.style.opacity = scheduled ? "1" : "0.55";
      whenInput.required = scheduled;
    }
    sel.addEventListener("change", sync);
    sync();
  })();
</script>

<style>
input[type="datetime-local"] { width: 260px; padding: 8px 10px; font-size: 14px; font-family: inherit; border: 1px solid var(--admin-border); border-radius: var(--admin-radius-sm); background: var(--admin-bg); color: var(--admin-fg); }
</style>
