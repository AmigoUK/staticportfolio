<% layout("/layouts/admin-base", { title: "Edit page — " + it.page.title, user: it.user, adminBase: it.adminBase, csrfToken: it.csrfToken }) %>
<section class="page">
  <header class="page-head">
    <p class="back-crumb"><a href="<%= it.adminBase %>/pages/">← Pages</a></p>
    <h1>Edit page: <code><%= it.page.slug %></code></h1>
  </header>

  <form method="post" action="<%= it.adminBase %>/pages/<%= it.page.slug %>">
    <input type="hidden" name="_csrf" value="<%= it.csrfToken %>" />

    <label class="form-row">
      <span>Title</span>
      <input type="text" name="title" required maxlength="200" value="<%= it.page.title %>" />
    </label>

    <label class="form-row">
      <span>Meta description (shown in search results and og:description)</span>
      <input type="text" name="meta_description" maxlength="500" value="<%= it.page.meta_description || '' %>" />
    </label>

    <label class="form-row">
      <span>Body — rich text. Formatting is sanitized server-side on save (whitelist: h2/h3/h4, p, lists, blockquote, code, links, images).</span>
      <textarea name="body_html" data-rte rows="20"><%= it.page.body_html || '' %></textarea>
    </label>

    <label class="form-row form-row-inline">
      <input type="checkbox" name="published" value="1" <%= it.page.published ? "checked" : "" %> />
      <span>Published (uncheck to keep the page out of the next publish)</span>
    </label>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save</button>
      <a class="btn btn-ghost" href="<%= it.adminBase %>/pages/">Cancel</a>
    </div>
  </form>
</section>

<script src="<%= it.adminBase %>/static/mini-rte.js"></script>
