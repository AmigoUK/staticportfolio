<% layout("/layouts/admin-base", { title: "Writing", user: it.user, adminBase: it.adminBase, csrfToken: it.csrfToken }) %>
<section class="page">
  <header class="page-head">
    <div class="head-row">
      <h1>Writing</h1>
      <a class="btn btn-primary" href="<%= it.adminBase %>/writing/new">+ New post</a>
    </div>
    <p>Long-form posts. Drafts are kept out of /writing/ until published.</p>
  </header>

  <% if (it.flash === "saved") { %><p class="flash flash-ok">Saved.</p><% } %>
  <% if (it.flash === "created") { %><p class="flash flash-ok">Created.</p><% } %>
  <% if (it.flash === "deleted") { %><p class="flash flash-ok">Deleted.</p><% } %>

  <table class="data-table">
    <thead><tr><th>Date</th><th>Slug</th><th>Title</th><th>Status</th><th>Actions</th></tr></thead>
    <tbody>
      <% it.posts.forEach(function(p){ %>
      <tr>
        <td><%= (p.published_at || '').slice(0,10) || '—' %></td>
        <td><code><%= p.slug %></code></td>
        <td><%= p.title %></td>
        <td><%= p.published ? "Published" : "Draft" %></td>
        <td class="actions">
          <a class="btn btn-ghost" href="<%= it.adminBase %>/writing/<%= p.id %>/edit">Edit</a>
          <form method="post" action="<%= it.adminBase %>/writing/<%= p.id %>/delete" class="inline" onsubmit="return confirm('Delete this post?')">
            <input type="hidden" name="_csrf" value="<%= it.csrfToken %>" />
            <button type="submit" class="btn btn-ghost btn-danger">Delete</button>
          </form>
        </td>
      </tr>
      <% }); %>
      <% if (it.posts.length === 0) { %>
      <tr><td colspan="5" class="empty-cell">No posts yet. Click <em>+ New post</em> to write your first.</td></tr>
      <% } %>
    </tbody>
  </table>
</section>
