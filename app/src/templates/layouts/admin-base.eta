<%
const title = it.title || "Admin";
const user = it.user || null;
const adminBase = it.adminBase || "/admin";
%><!doctype html>
<html lang="en" data-admin-base="<%= adminBase %>">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; frame-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self';" />
  <title><%= title %> — Portfolio CMS</title>
  <% if (user) { %>
  <script>
  /* Theme bootstrap — runs sync before paint so admin doesn't flash. */
  (function(){
    try {
      var s = localStorage.getItem("jd.theme");
      if (s !== "light" && s !== "dark") {
        s = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      document.documentElement.dataset.theme = s;
    } catch(_) { /* private mode etc — ignore */ }
  })();
  </script>
  <link rel="stylesheet" href="<%= adminBase %>/tokens.css" />
  <% } %>
  <link rel="stylesheet" href="<%= adminBase %>/static/admin.css" />
</head>
<body class="admin <%= user ? 'admin-shell' : 'admin-unauthed' %>">
  <% if (user) { %>
  <input type="checkbox" id="admin-sidebar-toggle" class="admin-sidebar-toggle-input" aria-hidden="true" />
  <label for="admin-sidebar-toggle" class="admin-sidebar-toggle" aria-label="Toggle navigation" role="button" tabindex="0">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
  </label>

  <aside class="admin-sidebar" aria-label="Primary">
    <a href="<%= adminBase %>/" class="admin-brand">Portfolio CMS</a>
    <nav class="admin-nav">
      <a href="<%= adminBase %>/" data-section="dashboard">Dashboard</a>
      <a href="<%= adminBase %>/pages/" data-section="pages">Pages</a>
      <a href="<%= adminBase %>/work/" data-section="work">Work</a>
      <a href="<%= adminBase %>/writing/" data-section="writing">Writing</a>
      <a href="<%= adminBase %>/media/" data-section="media">Media</a>
      <a href="<%= adminBase %>/themes/" data-section="themes">Themes</a>
      <a href="<%= adminBase %>/menu/" data-section="menu">Menu</a>
      <a href="<%= adminBase %>/fonts/" data-section="fonts">Fonts</a>
      <a href="<%= adminBase %>/settings/" data-section="settings">Settings</a>
    </nav>
    <div class="admin-sidebar-footer">
      <form class="admin-publish-inline" method="post" action="<%= adminBase %>/publish">
        <input type="hidden" name="_csrf" value="<%= it.csrfToken || '' %>" />
        <button type="submit" class="btn btn-primary btn-publish" title="Regenerate the public site with current DB state">Publish</button>
      </form>
      <button type="button" class="btn btn-ghost btn-block admin-theme-toggle" data-theme-toggle aria-label="Toggle theme">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <span class="admin-theme-toggle-label">Theme</span>
      </button>
      <form class="admin-logout" method="post" action="<%= adminBase %>/logout">
        <input type="hidden" name="_csrf" value="<%= it.csrfToken || '' %>" />
        <button type="submit" class="btn btn-ghost btn-block">Log out (<%= user.username %>)</button>
      </form>
    </div>
  </aside>
  <% } %>

  <main class="admin-main">
    <div id="global-flash" hidden></div>
    <%~ it.body %>
  </main>

  <% if (user) { %>
  <script>
  (function(){
    // Highlight the currently-active sidebar link.
    var path = location.pathname.replace(/\/+$/, "/") || "/";
    var links = document.querySelectorAll(".admin-nav a");
    var best = null;
    var bestLen = -1;
    links.forEach(function(a){
      var href = a.getAttribute("href");
      var norm = href.replace(/\/+$/, "/");
      var matches = false;
      if (norm === "<%= adminBase %>/") {
        matches = (path === norm);
      } else {
        matches = (path === norm) || path.indexOf(norm) === 0;
      }
      if (matches && norm.length > bestLen) {
        best = a;
        bestLen = norm.length;
      }
    });
    if (best) best.classList.add("is-active");

    // Theme toggle in the sidebar footer.
    var toggleBtn = document.querySelector(".admin-theme-toggle");
    if (toggleBtn) {
      toggleBtn.addEventListener("click", function () {
        var next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem("jd.theme", next); } catch (_) {}
      });
    }

    // Render the publish-result banner from query params.
    var params = new URLSearchParams(location.search);
    var box = document.getElementById("global-flash");
    if (!box) return;
    if (params.get("msg") === "published") {
      var pages = params.get("pages") || "?";
      box.className = "flash flash-ok";
      box.textContent = "Published — " + pages + " pages regenerated. The public site is live.";
      box.hidden = false;
    } else if (params.get("err")) {
      box.className = "flash flash-warn";
      box.textContent = params.get("err");
      box.hidden = false;
    }
  })();
  </script>
  <% } %>
</body>
</html>
