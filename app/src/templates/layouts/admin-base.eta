<%
const title = it.title || "Admin";
const user = it.user || null;
const adminBase = it.adminBase || "/admin";
%><!doctype html>
<html lang="en" data-admin-base="<%= adminBase %>">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; frame-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self';" />
  <title><%= title %> — Portfolio CMS</title>
  <script>
  /* Theme bootstrap — runs sync before paint so admin (and the login
     page) don't flash. Applies to both authenticated and login views. */
  (function(){
    try {
      var s = localStorage.getItem("jd.theme");
      if (s !== "light" && s !== "dark") {
        s = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      document.documentElement.dataset.theme = s;
    } catch(_) { /* private mode etc — ignore */ }
  })();
  </script>
  <link rel="stylesheet" href="<%= adminBase %>/tokens.css" />
  <link rel="stylesheet" href="<%= adminBase %>/static/admin.css" />
</head>
<body class="admin <%= user ? 'admin-shell' : 'admin-unauthed' %>">
  <% if (user) { %>
  <input type="checkbox" id="admin-sidebar-toggle" class="admin-sidebar-toggle-input" aria-hidden="true" />
  <label for="admin-sidebar-toggle" class="admin-sidebar-toggle" aria-label="Toggle navigation" role="button" tabindex="0">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
  </label>

  <aside class="admin-sidebar" aria-label="Primary">
    <a href="<%= adminBase %>/" class="admin-brand">Portfolio CMS</a>
    <nav class="admin-nav">
      <a href="<%= adminBase %>/" data-section="dashboard">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        <span>Dashboard</span>
      </a>
      <a href="<%= adminBase %>/pages/" data-section="pages">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/></svg>
        <span>Pages</span>
      </a>
      <a href="<%= adminBase %>/work/" data-section="work">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
        <span>Work</span>
      </a>
      <a href="<%= adminBase %>/blog/" data-section="blog">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
        <span>Blog</span>
      </a>
      <a href="<%= adminBase %>/media/" data-section="media">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        <span>Media</span>
      </a>
      <a href="<%= adminBase %>/themes/" data-section="themes">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="13.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/><circle cx="17.5" cy="11.5" r="1.5" fill="currentColor" stroke="none"/><circle cx="8.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/><circle cx="6.5" cy="11.5" r="1.5" fill="currentColor" stroke="none"/><path d="M12 22a10 10 0 1 1 0-20c5.523 0 10 4.03 10 9 0 3.314-2.686 6-6 6h-1.5a1.5 1.5 0 0 0-1.06 2.56 1.5 1.5 0 0 1-1.06 2.44H12z"/></svg>
        <span>Themes</span>
      </a>
      <a href="<%= adminBase %>/menu/" data-section="menu">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        <span>Menu</span>
      </a>
      <a href="<%= adminBase %>/fonts/" data-section="fonts">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4 7 4 4 20 4 20 7"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="12" y1="4" x2="12" y2="20"/></svg>
        <span>Fonts</span>
      </a>
      <a href="<%= adminBase %>/settings/" data-section="settings">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        <span>Settings</span>
      </a>
      <a href="<%= adminBase %>/help/" data-section="help" class="admin-nav-help">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <span>Help</span>
      </a>
    </nav>
    <div class="admin-sidebar-footer">
      <form class="admin-publish-inline" method="post" action="<%= adminBase %>/publish">
        <input type="hidden" name="_csrf" value="<%= it.csrfToken || '' %>" />
        <button type="submit" class="btn btn-primary btn-publish" title="Regenerate the public site with current DB state">Publish</button>
      </form>
      <button type="button" class="btn btn-ghost btn-block admin-theme-toggle" data-theme-toggle aria-label="Toggle theme">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <span class="admin-theme-toggle-label">Theme</span>
      </button>
      <form class="admin-logout" method="post" action="<%= adminBase %>/logout">
        <input type="hidden" name="_csrf" value="<%= it.csrfToken || '' %>" />
        <button type="submit" class="btn btn-ghost btn-block">Log out (<%= user.username %>)</button>
      </form>
    </div>
  </aside>
  <% } %>

  <main class="admin-main">
    <div id="global-flash" hidden></div>
    <%~ it.body %>
  </main>

  <% if (user) { %>
  <script>
  (function(){
    // Highlight the currently-active sidebar link.
    var path = location.pathname.replace(/\/+$/, "/") || "/";
    var links = document.querySelectorAll(".admin-nav a");
    var best = null;
    var bestLen = -1;
    links.forEach(function(a){
      var href = a.getAttribute("href");
      var norm = href.replace(/\/+$/, "/");
      var matches = false;
      if (norm === "<%= adminBase %>/") {
        matches = (path === norm);
      } else {
        matches = (path === norm) || path.indexOf(norm) === 0;
      }
      if (matches && norm.length > bestLen) {
        best = a;
        bestLen = norm.length;
      }
    });
    if (best) best.classList.add("is-active");

    // Theme toggle in the sidebar footer.
    var toggleBtn = document.querySelector(".admin-theme-toggle");
    if (toggleBtn) {
      toggleBtn.addEventListener("click", function () {
        var next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem("jd.theme", next); } catch (_) {}
      });
    }

    // Render the publish-result banner from query params.
    var params = new URLSearchParams(location.search);
    var box = document.getElementById("global-flash");
    if (!box) return;
    if (params.get("msg") === "published") {
      var pages = params.get("pages") || "?";
      box.className = "flash flash-ok";
      box.textContent = "Published — " + pages + " pages regenerated. The public site is live.";
      box.hidden = false;
    } else if (params.get("err")) {
      box.className = "flash flash-warn";
      box.textContent = params.get("err");
      box.hidden = false;
    }
  })();
  </script>
  <% } %>
</body>
</html>
