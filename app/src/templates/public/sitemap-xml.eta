<%
const base = (it.site["site.base_url"] || "").replace(/\/+$/, "");
const today = new Date().toISOString().slice(0, 10);
%><?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc><%= base %>/</loc><lastmod><%= today %></lastmod></url>
  <url><loc><%= base %>/about.html</loc><lastmod><%= today %></lastmod></url>
  <url><loc><%= base %>/now.html</loc><lastmod><%= today %></lastmod></url>
  <url><loc><%= base %>/contact.html</loc><lastmod><%= today %></lastmod></url>
  <url><loc><%= base %>/work/</loc><lastmod><%= today %></lastmod></url>
  <% it.workEntries.forEach(function(w){ if (!w.is_disabled) { %>
  <url><loc><%= base %>/work/<%= w.slug %>.html</loc><lastmod><%= w.updated_at.slice(0,10) %></lastmod></url>
  <% } }); %>
  <url><loc><%= base %>/writing/</loc><lastmod><%= today %></lastmod></url>
  <% it.posts.forEach(function(p){ %>
  <url><loc><%= base %>/writing/<%= p.slug %>.html</loc><lastmod><%= (p.published_at || p.updated_at).slice(0,10) %></lastmod></url>
  <% }); %>
</urlset>
