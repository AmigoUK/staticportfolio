<% layout("/layouts/public-base", { title: it.post.title + " — " + it.site["site.brand"], description: it.post.meta_description || it.post.dek, ogType: "article", ogTitle: it.post.title, ogDescription: it.post.dek, prefix: "../", site: it.site, currentPath: "writing/" }) %>
    <article class="post">
      <header class="page-head">
        <div class="wrap">
          <p class="eyebrow"><time datetime="<%= it.post.published_at %>"><%= it.post.published_at %></time></p>
          <h1><%= it.post.title %></h1>
          <p class="lede"><%= it.post.dek %></p>
        </div>
      </header>
      <div class="prose-body">
        <div class="wrap">
          <%~ it.post.body_html %>
          <p class="back-link"><a class="btn btn-ghost" href="./">← All writing</a></p>
        </div>
      </div>
    </article>
