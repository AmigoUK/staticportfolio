<% layout("/layouts/public-base", { title: "Page not found — " + it.site["site.brand"], description: "Page not found — return to " + it.site["site.brand"] + "'s portfolio.", ogType: "website", prefix: "", site: it.site, currentPath: "404.html" }) %>
    <section class="page-head">
      <div class="wrap">
        <h1>Page not found</h1>
        <p class="lede">That URL doesn't match anything on this site.</p>
        <p class="back-link"><a class="btn btn-primary" href="./">← Back to home</a></p>
      </div>
    </section>
