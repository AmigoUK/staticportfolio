# Copy to .env and fill in. Never commit .env.

# Used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-hex-string-at-least-32-chars

# Port the Fastify admin app listens on (loopback only).
PORT=3000
HOST=127.0.0.1

# Public-facing path prefix Apache reverse-proxies to this app.
# With Apache config `ProxyPass /staticportfolio/admin/ http://127.0.0.1:3000/admin/`,
# Fastify itself sees URLs starting with /admin/.
ADMIN_BASE_PATH=/admin

# Set to 1 in production behind HTTPS to enable Secure cookie flag.
COOKIE_SECURE=0

# Path to the SQLite database file.
DB_PATH=./data/portfolio.db

# Where uploaded raw media is stored before it gets copied to public/ on publish.
UPLOADS_DIR=./uploads

# Where the published static site is regenerated.
PUBLIC_DIR=./public

# Where the per-publish staging happens. Atomically renamed onto PUBLIC_DIR.
PUBLIC_STAGING_DIR=./public.next
