# Systemd unit: hot backup of the Portfolio CMS database + uploads.
#
# Triggered by portfolio-cms-backup.timer (daily). Can also be invoked
# manually:
#
#   sudo systemctl start portfolio-cms-backup.service
#   journalctl -u portfolio-cms-backup -n 50 --no-pager
#
# Output goes to /var/backups/portfolio-cms/ — adjust BACKUP_DIR via the
# Environment= line below or via the .env file the app uses.

[Unit]
Description=Portfolio CMS — hot backup (DB + uploads)
After=portfolio-cms.service

[Service]
Type=oneshot
WorkingDirectory=/var/www/html/staticportfolio
ExecStart=/usr/bin/npm run backup
User=root
Group=root
Environment=NODE_ENV=production
Environment=BACKUP_DIR=/var/backups/portfolio-cms
Environment=RETAIN_DAYS=14
StandardOutput=journal
StandardError=journal
SyslogIdentifier=portfolio-cms-backup
